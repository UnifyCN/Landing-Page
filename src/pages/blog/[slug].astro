---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostNav from "../../components/blog/PostNav.astro";
import CTABand from "../../components/sections/CTABand.astro";
import { getAllPosts, getPostBySlug } from "../../lib/sanity/queries";
import { urlFor } from "../../lib/sanity/client";
import { toHTML } from "@portabletext/to-html";
import { blogPostingLd, breadcrumbLd, faqLd, serializeLd } from "../../lib/seo";
import { blogCategoryLabel, toBlogCategory } from "../../lib/blog-categories.js";
import "../../styles/prose.css";

// Legacy slugs that were renamed. These URLs accumulated ranking equity in Google
// (verified via Search Console) and must 301 to the new slug, NOT bounce to /blog,
// or the equity and the indexed position are lost. Each key is the exact old slug
// Google still has indexed (including parens/emoji); the value is the live slug.
// Add an entry whenever a post slug changes.
const TEER3_CANONICAL = "the-easiest-skilled-jobs-to-transition-into-teer-3-for-pr-purposes-in-canada";
const LEGACY_SLUG_REDIRECTS: Record<string, string> = {
  "the-easiest-skilled-jobs-to-transition-into-(teer-3)-for-pr-purposes-in-canada": TEER3_CANONICAL,
  "the-easiest-skilled-roles-to-transition-into-(teer-3)-for-pr-purposes-in-canada": TEER3_CANONICAL,
  "how-entry-level-jobs-can-lead-to-permanent-residency-(pr)-in-canada-🇨🇦":
    "how-entry-level-jobs-can-lead-to-permanent-residency-pr-in-canada",
  "5-mistakes-international-students-make-when-applying-for-co-ops-at-sfu-(and-how-to-avoid-them-)":
    "5-mistakes-international-students-make-when-applying-for-co-ops-at-sfu",
  "how-to-use-lmias-and-pnps-to-transition-to-skilled-work-in-canada":
    "how-to-get-pr-in-canada-lmia-and-pnp-for-international-workers",
};

const toHTMLOptions: any = {
  components: {
    types: {
      // @sanity/table — plain string cells, first row = header
      table: ({ value }: any) => {
        const rows: any[] = value.rows ?? [];
        if (!rows.length) return '';

        const [headerRow, ...bodyRows] = rows;
        const thead = `<thead><tr>${
          (headerRow.cells as string[]).map((c) => `<th>${c}</th>`).join('')
        }</tr></thead>`;
        const tbody = bodyRows.length
          ? `<tbody>${bodyRows.map((row: any) =>
              `<tr>${(row.cells as string[]).map((c) => `<td>${c}</td>`).join('')}</tr>`
            ).join('')}</tbody>`
          : '';
        return `<table>${thead}${tbody}</table>`;
      },
      // Custom richTable — cells are objects with PortableText value (migrated content)
      richTable: ({ value }: any) => {
        const rows: any[] = value.rows ?? [];
        if (!rows.length) return '';

        const headerCount: number = value.headerRows ?? 0;
        const header = rows.slice(0, headerCount);
        const body = rows.slice(headerCount);

        const renderCells = (cells: any[], tag: 'th' | 'td') =>
          cells.map((cell: any) => `<${tag}>${toHTML(cell.value ?? [], toHTMLOptions)}</${tag}>`).join('');

        const thead = header.length
          ? `<thead><tr>${renderCells(header[0].cells, 'th')}</tr></thead>`
          : '';
        const tbody = body.length
          ? `<tbody>${body.map((row: any) => `<tr>${renderCells(row.cells, 'td')}</tr>`).join('')}</tbody>`
          : '';

        return `<table>${thead}${tbody}</table>`;
      },
    },
  },
};

const { slug } = Astro.params;
const [post, allPosts] = await Promise.all([
  getPostBySlug(slug!),
  getAllPosts(),
]);

if (!post) {
  const legacyTarget = LEGACY_SLUG_REDIRECTS[slug!];
  if (legacyTarget) return Astro.redirect(`/blog/${legacyTarget}`, 301);
  return Astro.redirect("/blog");
}

const postIndex = allPosts.findIndex((p) => p.slug.current === slug);
const prev = postIndex < allPosts.length - 1 ? allPosts[postIndex + 1] : null;
const next = postIndex > 0 ? allPosts[postIndex - 1] : null;

const updatedDate = new Date(post.updatedAt ?? post.publishedAt).toLocaleDateString("en-CA", {
  year: "numeric",
  month: "numeric",
  day: "numeric",
});

const bodyHtml = toHTML(post.body, toHTMLOptions);
const category = toBlogCategory(post.category);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const thumbnailUrl = urlFor(post.thumbnail).width(1200).height(630).url();   // 1200x630 for JSON-LD/OG ratio
const heroImageUrl = urlFor(post.thumbnail).width(1200).url();               // 1200 wide, height auto — what the page hero <img> actually loads (must match the preload below)

const blogPostingLdStr = serializeLd(
  blogPostingLd({
    title: post.title,
    description: post.description,
    thumbnailUrl,
    publishedAt: post.publishedAt,
    updatedAt: post.updatedAt,
    canonicalUrl,
  })
);
const breadcrumbLdStr = serializeLd(
  breadcrumbLd([
    { name: "Home", item: "https://unifysocial.ca" },
    { name: "Blog", item: "https://unifysocial.ca/blog" },
    { name: post.title, item: canonicalUrl },
  ])
);
const faqLdStr = post.faqs?.length
  ? serializeLd(faqLd(post.faqs.map((f) => ({ q: f.question, a: f.answer }))))
  : null;
---

<BaseLayout
  title={post.seoTitle || `${post.title} | Unify Social`}
  description={post.seoDescription || post.description}
  ogImage={thumbnailUrl}
  bodyBg="#ffffff"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={blogPostingLdStr} />
    <script type="application/ld+json" set:html={breadcrumbLdStr} />
    {faqLdStr && <script type="application/ld+json" set:html={faqLdStr} />}
    <link rel="preload" as="image" href={heroImageUrl} />
  </Fragment>

  <main class="post-main">
    <!-- ── Post header ── -->
    <header class="post-header">
      <a href="/blog" class="post-back">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M11.5 7H2.5M2.5 7L6.5 3M2.5 7L6.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        All articles
      </a>
      <h1 class="post-title">{post.title}</h1>
    </header>

    <!-- ── Hero image ── -->
    <div class="post-hero-img-wrap">
      <img
        src={heroImageUrl}
        alt={post.title}
        class="post-hero-img"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <!-- ── Metadata ── -->
    <div class="post-meta">
      <span>Last updated: <strong>{updatedDate}</strong></span>
      <span class="post-meta-sep" aria-hidden="true">|</span>
      <a href={`/blog?category=${category}`} class="post-meta-cat">{blogCategoryLabel(category)}</a>
      {post.craReference && (
        <>
          <span class="post-meta-sep" aria-hidden="true">|</span>
          <span>CRA Reference: <span class="post-meta-ref">{post.craReference}</span></span>
        </>
      )}
    </div>

    {post.keyTakeaway && (
      <aside class="post-takeaway">
        <span class="post-takeaway-label">Key takeaway</span>
        <p>{post.keyTakeaway}</p>
      </aside>
    )}

    <!-- ── Prose body ── -->
    <article class="prose" set:html={bodyHtml} />

    {post.faqs && post.faqs.length > 0 && (
      <section class="post-faq" aria-labelledby="post-faq-h">
        <h2 id="post-faq-h">Frequently asked questions</h2>
        {post.faqs.map((f) => (
          <details class="post-faq-item">
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </section>
    )}
  </main>

  <!-- ── Prev / Next ── -->
  <PostNav
    prev={prev ? { title: prev.title, slug: prev.slug.current } : null}
    next={next ? { title: next.title, slug: next.slug.current } : null}
  />

  <CTABand />
</BaseLayout>

<style>
  /* Key takeaway callout (answer-first block for snippets + AI) */
  .post-takeaway {
    margin: 0 0 2rem;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--color-brand-red);
    background: #faf7f1;
    border-radius: 0 var(--radius-cta) var(--radius-cta) 0;
  }
  .post-takeaway-label {
    display: block;
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-brand-red);
    margin-bottom: 0.4rem;
  }
  .post-takeaway p {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.55;
    color: var(--color-text);
    font-weight: 500;
  }

  /* FAQ (visible + FAQPage schema) */
  .post-faq {
    margin: 3rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid rgba(23, 22, 22, 0.1);
  }
  .post-faq h2 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    margin: 0 0 1.25rem;
  }
  .post-faq-item { border-bottom: 1px solid rgba(23, 22, 22, 0.1); }
  .post-faq-item summary {
    list-style: none;
    cursor: pointer;
    padding: 1.1rem 2.5rem 1.1rem 0;
    position: relative;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.02rem, 2.2vw, 1.18rem);
    color: var(--color-text);
  }
  .post-faq-item summary::-webkit-details-marker { display: none; }
  .post-faq-item summary::after {
    content: "+";
    position: absolute;
    right: 0.25rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.4rem;
    color: var(--color-brand-red);
  }
  .post-faq-item[open] summary::after { content: "\2212"; }
  .post-faq-item summary:focus-visible { outline: 2px solid var(--color-brand-red); outline-offset: 3px; }
  .post-faq-item p {
    margin: 0;
    padding: 0 0 1.2rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .post-main {
    max-width: 800px;
    margin: 0 auto;
    padding: calc(67px + 0.75rem) 1.5rem 0;
  }

  /* ── Back link ── */
  .post-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    margin-bottom: 1.25rem;
    transition: color 0.2s ease;
  }

  .post-back:hover {
    color: var(--color-brand-red);
  }

  /* ── Title ── */
  .post-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.875rem, 5vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: var(--color-ink);
    margin: 0 0 1.5rem;
  }

  /* ── Hero image ── */
  .post-hero-img-wrap {
    max-width: 1200px;
    margin: 0 auto 0;
    padding: 0 1.5rem;
    width: calc(100% + 3rem);
    margin-left: -1.5rem;
  }

  .post-hero-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-radius: 8px;
  }

  /* ── Metadata ── */
  .post-meta {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin: 1.25rem 0 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .post-meta strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .post-meta-sep {
    opacity: 0.4;
  }

  .post-meta-ref {
    color: var(--color-brand-red);
  }

  .post-meta-cat {
    color: var(--color-brand-red);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .post-meta-cat:hover {
    border-bottom-color: currentColor;
  }

  /* ── Prose ── */
  .prose {
    padding-bottom: 3rem;
  }

  /* ── Tablet ── */
  @media (min-width: 810px) {
    .post-main {
      padding: calc(67px + 0.75rem) 3rem 0;
    }

    .post-hero-img-wrap {
      width: calc(100% + 6rem);
      margin-left: -3rem;
      padding: 0 3rem;
    }

    .post-hero-img {
      border-radius: 10px;
    }
  }

  /* ── Desktop ── */
  @media (min-width: 1400px) {
    .post-main {
      padding: calc(67px + 0.75rem) 5rem 0;
      max-width: 900px;
    }

    .post-hero-img-wrap {
      width: calc(100% + 10rem);
      margin-left: -5rem;
      padding: 0 5rem;
    }
  }
</style>
